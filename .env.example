# --- Ingestão / chunking ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# --- Vector store (Chroma, embutido, persiste em disco) ---
VECTORSTORE_PATH=data/vectorstore
VECTORSTORE_COLLECTION=documents
TOP_K=4

# --- LM Studio (servidor local, API compatível com OpenAI) ---
# Abra o LM Studio, carregue um modelo e clique em "Start Server" (Developer tab).
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=llama-3.1-8b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Modelo de embedding carregado no LM Studio (confira o id exato via
# `curl http://localhost:1234/v1/models` após carregar o EmbeddingGemma)
LM_STUDIO_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-q8_0

# --- Resumo (map-reduce) ---
# Caracteres por bloco enviado ao LLM. Maior = menos chamadas = mais rápido,
# mas exige um modelo com contexto suficiente. Se usar um modelo sem "thinking"
# (mais rápido por chamada), pode reduzir esse valor sem medo.
SUMMARIZE_BATCH_CHARS=24000

# --- Imagens (busca multimodal) ---
IMAGES_RAW_PATH=data/raw/images
IMAGE_VECTORSTORE_COLLECTION_VISUAL=images_visual
IMAGE_VECTORSTORE_COLLECTION_TEXT=images_text

# Modelo com suporte a visão, carregado no LM Studio (além do LLM de chat e do
# EmbeddingGemma). Confira o id exato via `curl http://localhost:1234/v1/models`.
LM_STUDIO_VISION_MODEL=gemma4-12b-qat-uncensored-hauhaucs-balanced
# Modelos de visão "thinking" gastam parte desse orçamento raciocinando antes de
# escrever a descrição — se a descrição estiver cortando (erro de finish_reason=length
# no log), aumente este valor. Se preferir, prefira um modelo de visão sem "thinking".
VISION_MAX_TOKENS=4096

# CrispEmbed (github.com/CrispStrobe/CrispEmbed): servidor local com build CUDA
# que serve o SigLIP GGUF (o LM Studio ainda não suporta esse modelo). Suba com:
#   crispembed-server --vit <caminho>\siglip-so400m-patch14-384.gguf --port 8081
# (ou rode embedding_image_server\start-server.ps1, que já monta esse comando)
CRISPEMBED_BASE_URL=http://localhost:8081
